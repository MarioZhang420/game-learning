{
  "name": "game-learning",
  "private": true,
  "description": "Open-source companion that brings your study material into the games you play",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pipeline": "pnpm --filter @game-learning/pipeline start",
    "app": "pnpm --filter @game-learning/desktop dev",
    "hub": "pnpm --filter @game-learning/hub start",
    "sim": "pnpm --filter @game-learning/simulator start",
    "mod:install": "dotnet build integrations/hollow-knight -c Release -p:InstallMod=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
