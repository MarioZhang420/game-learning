{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hello"
    },
    "protocol": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "const": "game"
    },
    "token": {
      "type": "string"
    },
    "integration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Stable id of the integration, e.g. \"hollow-knight\""
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["id", "name", "version"],
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z0-9-]+:)?[a-z0-9-]+(\\.[a-z0-9-]+)*$"
          },
          "description": "Event names this integration can send"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z0-9-]+:)?[a-z0-9-]+(\\.[a-z0-9-]+)*$"
          },
          "description": "Effect names this integration can apply"
        }
      },
      "required": ["events", "effects"],
      "additionalProperties": false
    }
  },
  "required": ["type", "protocol", "role", "token", "integration", "game", "capabilities"],
  "additionalProperties": false
}
