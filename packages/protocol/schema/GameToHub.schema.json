{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique per event, so retries can be ignored"
        },
        "name": {
          "type": "string",
          "pattern": "^([a-z0-9-]+:)?[a-z0-9-]+(\\.[a-z0-9-]+)*$"
        },
        "at": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["type", "id", "name", "at"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "effect.result"
        },
        "effectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["applied", "rejected", "failed"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["type", "effectId", "status"],
      "additionalProperties": false
    }
  ]
}
