{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "answer"
        },
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "answer": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "choice"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "index"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "boolean"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": ["kind", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["type", "challengeId", "answer"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dismiss"
        },
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["type", "challengeId"],
      "additionalProperties": false
    }
  ]
}
